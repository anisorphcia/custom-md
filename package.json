{
  "name": "semantic-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter playground-server dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:vue": "pnpm --filter playground-vue dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint packages apps tests",
    "format": "biome format --write packages apps tests *.json *.md",
    "benchmark": "pnpm --filter @semantic-md/core benchmark"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "^1.54.1",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
