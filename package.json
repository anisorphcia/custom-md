{
  "name": "semantic-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anisorphcia/custom-md.git"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter playground-server dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:vue": "pnpm --filter playground-vue dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint packages apps tests",
    "format": "biome format --write packages apps tests *.json *.md",
    "format:check": "biome format packages apps tests *.json *.md",
    "prepare": "husky",
    "benchmark": "pnpm --filter @semantic-md/core benchmark",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.54.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
