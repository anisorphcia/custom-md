{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@semantic-md/core": ["packages/core/src/index.ts"],
      "@semantic-md/protocol": ["packages/protocol/src/index.ts"],
      "@semantic-md/react": ["packages/react/src/index.ts"],
      "@semantic-md/vue": ["packages/vue/src/index.ts"],
      "@semantic-md/example-protocol": ["packages/example-protocol/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
