{
  "name": "@semantic-md/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@semantic-md/core": "workspace:*",
    "@semantic-md/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.1.0",
    "react-dom": "^18.3.1 || ^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anisorphcia/custom-md.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/anisorphcia/custom-md#readme",
  "bugs": {
    "url": "https://github.com/anisorphcia/custom-md/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
